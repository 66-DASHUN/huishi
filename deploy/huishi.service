[Unit]
Description=Huishi Flask application
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
User=huishi
Group=huishi
WorkingDirectory=/opt/huishi
EnvironmentFile=/opt/huishi/.env
ExecStart=/opt/huishi/.venv/bin/gunicorn -w 2 -k gthread --threads 4 --timeout 240 -b 127.0.0.1:8000 wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
