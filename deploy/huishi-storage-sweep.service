[Unit]
Description=Huishi storage sweep
After=postgresql.service

[Service]
Type=oneshot
User=huishi
Group=huishi
WorkingDirectory=/opt/huishi
EnvironmentFile=/opt/huishi/.env
# Canvas projects currently persist in browser storage, so deletion is unsafe until their asset references are server-tracked.
ExecStart=/opt/huishi/.venv/bin/flask --app wsgi:app storage-sweep
