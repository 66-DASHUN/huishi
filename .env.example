# Copy this file to .env and adjust values for your server.
# Environment variables exported by systemd or shell take priority over this file.

# Production basics. Replace all secrets before going online.
HUISHI_ENV=production
HUISHI_SECRET_KEY=
HUISHI_ADMIN_PASSWORD=
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HUISHI_ENCRYPTION_KEY=

# Database, uploads and logs. Fresh production deploys should use PostgreSQL.
DATABASE_URL=postgresql://huishi:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5432/huishi_prod
HUISHI_REQUIRE_POSTGRES=1
# SQLite fallback only. Set HUISHI_REQUIRE_POSTGRES=0 before using it.
# HUISHI_DATABASE=/var/lib/huishi/huishi.sqlite3
HUISHI_OUTPUT_DIR=/var/lib/huishi/uploads
HUISHI_LOG_DIR=/var/log/huishi
HUISHI_CANVAS_APP_URL=http://127.0.0.1:3000

# Upload storage. Keep local mode unless a durable remote provider is configured.
HUISHI_STORAGE_MODE=local
HUISHI_STORAGE_BUCKET=
HUISHI_STORAGE_ACCESS_KEY_ID=
HUISHI_STORAGE_SECRET_ACCESS_KEY=
# Required for R2 and OSS; optional for S3-compatible services.
HUISHI_STORAGE_ENDPOINT_URL=
# AWS region for S3. R2 defaults to auto.
HUISHI_STORAGE_REGION=
HUISHI_STORAGE_PREFIX=uploads/

# SQLite fallback hardening. Keep the database on a local disk, not a network mount.
HUISHI_SQLITE_TIMEOUT_SECONDS=30
HUISHI_SQLITE_BUSY_TIMEOUT_MS=30000

# Image API defaults. Admin provider settings can override these in the UI.
BASE_URL=https://qa.dashun9527.com
API_KEY=
HUISHI_IMAGE_API_TIMEOUT=180
HUISHI_IMAGE_API_MAX_RETRIES=0

# Generation queue. Use Redis/RQ for Ubuntu production and multi-worker safety.
HUISHI_GENERATION_QUEUE_BACKEND=rq
HUISHI_REDIS_URL=redis://127.0.0.1:6379/0
HUISHI_RQ_QUEUE_NAME=huishi-generation
HUISHI_RQ_JOB_TIMEOUT_SECONDS=1200
HUISHI_RQ_RESULT_TTL_SECONDS=60
HUISHI_RQ_FAILURE_TTL_SECONDS=86400
HUISHI_APP_IMPORT_PATH=app:create_app

# Upstream protection. Your upstream allows about 240 concurrent requests and 300 RPM.
HUISHI_UPSTREAM_MAX_CONCURRENCY=240
HUISHI_UPSTREAM_RPM_LIMIT=300
# Workers wait for shared upstream capacity instead of failing queued jobs immediately.
# Keep wait timeout + image API timeout below HUISHI_RQ_JOB_TIMEOUT_SECONDS.
HUISHI_GENERATION_LIMIT_WAIT_TIMEOUT_SECONDS=840
HUISHI_GENERATION_LIMIT_WAIT_SLEEP_SECONDS=1
# Keep stale detection above wait timeout + image API timeout.
HUISHI_GENERATION_TASK_STALE_SECONDS=1080
HUISHI_RATE_LIMIT_NAMESPACE=huishi
# Production defaults to requiring Redis so auth/email limits are shared across workers.
HUISHI_REQUIRE_REDIS_LIMITS=1

# In-process thread backend fallback for local development only.
HUISHI_GENERATION_WORKERS=3

# Product limits.
HUISHI_MAX_GENERATION_COUNT=10
HUISHI_MAX_ACTIVE_GENERATION_TASKS_PER_USER=2
HUISHI_MAX_REFERENCE_IMAGES=16
HUISHI_MAX_REFERENCE_IMAGE_BYTES=12M
HUISHI_MAX_CONTENT_LENGTH=64M

# Local upload storage governance.
# storage-sweep keeps visible asset files and active task references.
# It deletes true orphan files and hidden/deleted asset files only when they are older than the configured windows.
HUISHI_STORAGE_ORPHAN_RETENTION_DAYS=7
HUISHI_STORAGE_HIDDEN_RETENTION_DAYS=14
HUISHI_STORAGE_MAX_BYTES=200G
# Safety cap per sweep; retention days decide what is eligible for deletion.
HUISHI_STORAGE_SWEEP_MAX_DELETE_FILES=20000
# Safety window for in-flight generated files before they are written to records.
HUISHI_STORAGE_SWEEP_MIN_AGE_SECONDS=300
HUISHI_IMAGE_OPTIMIZE_ENABLED=1
HUISHI_IMAGE_JPEG_QUALITY=88
HUISHI_IMAGE_WEBP_QUALITY=86
HUISHI_IMAGE_PNG_COMPRESS_LEVEL=9

# SMTP email configuration.
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=your-email@qq.com
# SMTP_PASSWORD=your-smtp-auth-code
# SMTP_FROM=your-email@qq.com
# SMTP_SSL=1
# SMTP_TLS=0
