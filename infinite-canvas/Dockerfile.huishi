FROM oven/bun:1.3.14 AS web-build

WORKDIR /app/web
COPY web/package.json web/bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile --cache-dir=/root/.bun/install/cache

COPY VERSION /app/VERSION
COPY CHANGELOG.md /app/CHANGELOG.md
COPY web ./

ARG CANVAS_PARENT_ORIGINS
ENV CANVAS_PARENT_ORIGINS=${CANVAS_PARENT_ORIGINS}

# 挂载前缀。主站把它挂到同域子路径（/canvas-app），这样用户永远只看到绘世的
# 地址；留空则部署在根路径（独立域名、本地开发）。构建期必须传入——Next 的
# basePath 是编译期概念，运行期改不了。
ARG CANVAS_BASE_PATH=
ENV CANVAS_BASE_PATH=${CANVAS_BASE_PATH}
RUN bun run build

FROM node:22-bookworm-slim

WORKDIR /app
COPY VERSION /app/VERSION
COPY CHANGELOG.md /app/CHANGELOG.md
COPY --from=web-build /app/web/public /app/web/public
COPY --from=web-build /app/web/.next/standalone /app/web
COPY --from=web-build /app/web/.next/static /app/web/.next/static

ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && chown -R node:node /app

USER node

EXPOSE 3000

CMD ["sh", "-c", "cd /app/web && PORT=3000 node server.js"]

